---
import BaseLayout from "../layouts/BaseLayout.astro";

const sent = Astro.url.searchParams.get("sent");
---

<BaseLayout title="Contact | Tangoren Holf" description="Get in touch with Tangoren Holf. Contact our team for art consulting, interior design services, or inquiries about our collections and gallery.">
	<section class="contact-panel">
		<h1 class="contact-heading">CONTACT US</h1>

		<form
			class="contact-form"
			action="/api/contact"
			method="POST"
		>
			<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="display:none" />
			<div class="contact-form__row">
				<label class="contact-form__field">
					<span>First name*</span>
					<input type="text" name="firstName" autocomplete="given-name" required />
				</label>
				<label class="contact-form__field">
					<span>Last name*</span>
					<input type="text" name="lastName" autocomplete="family-name" required />
				</label>
			</div>

			<div class="contact-form__row">
				<label class="contact-form__field">
					<span>Email</span>
					<input type="email" name="email" autocomplete="email" />
				</label>
				<label class="contact-form__field">
					<span>Phone*</span>
					<input type="tel" name="phone" autocomplete="tel" required />
				</label>
			</div>

			<label class="contact-form__field contact-form__field--full">
				<span>Message*</span>
				<textarea name="message" rows="2" required></textarea>
			</label>

			<button type="submit">SUBMIT</button>
		</form>
		{sent === "1" && <p class="contact-email">Message sent successfully.</p>}
		{sent === "0" && <p class="contact-email">Could not send your message. Please try again.</p>}

		<p class="contact-email">Email art@tangorenholf.com</p>

		<div class="contact-socials">
			<a class="contact-social contact-social--instagram" href="#" aria-label="Instagram">
				<img src="/images/social/instagram.svg" alt="" aria-hidden="true" />
			</a>
			<a class="contact-social" href="https://www.facebook.com/profile.php?id=61581501545171" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
				<img src="/images/social/facebook.svg" alt="" aria-hidden="true" />
			</a>
		</div>
	</section>
</BaseLayout>
