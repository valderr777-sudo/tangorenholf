---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { Image, getImage } from "astro:assets";

const wallEntries = await getCollection("wall");
const sorted = wallEntries.sort((a, b) => {
	const numA = parseInt(a.id.replace(/\.md$/, ""), 10);
	const numB = parseInt(b.id.replace(/\.md$/, ""), 10);
	return numA - numB;
});

const rawImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/the-wall/*.{jpeg,jpg,png}', { eager: true });

const slugMap = new Map<string, number>();

const processedEntries = await Promise.all(sorted.map(async (entry) => {
	const assetPath = entry.data.image.replace('/images/', '/src/assets/images/');
	const module = rawImages[assetPath];
	
	let lightboxSrc = entry.data.image;
	let original = null;
	
	if (module) {
		original = module.default;
		const lightboxImage = await getImage({ src: original, width: 1600, format: 'webp' });
		lightboxSrc = lightboxImage.src;
	}

	// Generate URL-friendly slug from title (with dedup for duplicate titles)
	let slug = entry.data.title
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, "-")
		.replace(/^-|-$/g, "");
	const count = slugMap.get(slug) || 0;
	slugMap.set(slug, count + 1);
	if (count > 0) {
		const num = entry.id.replace(/\.md$/, "");
		slug = `${slug}-${num}`;
	}

	return {
		...entry,
		original,
		lightboxSrc,
		slug,
	};
}));

const collectionPageSchema = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	"@id": Astro.url.href + "#collectionpage",
	"url": Astro.url.href,
	"name": "The Wall | TANGOREN HOLF",
	"description": "Explore The Wall — TANGOREN HOLF's curated gallery of available artwork. Discover original pieces from established and emerging artists for your collection.",
	"hasPart": processedEntries.map((entry, i) => ({
		"@type": "VisualArtwork",
		"@id": Astro.url.href + "/" + entry.slug + "#artwork",
		"name": entry.data.title,
		"artist": { "@type": "Person", "name": entry.data.artist },
		"url": new URL("/the-wall/" + entry.slug, Astro.url).href,
		"image": new URL(entry.lightboxSrc, Astro.url).href,
		"dateCreated": entry.data.dateOfCreation,
		"position": i + 1,
	})),
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://tangorenholf.com/" },
		{ "@type": "ListItem", "position": 2, "name": "The Wall", "item": Astro.url.href },
	],
};
---

<BaseLayout title="The Wall | TANGOREN HOLF" description="Explore The Wall — TANGOREN HOLF's curated gallery of available artwork. Discover original pieces from established and emerging artists for your collection.">
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(collectionPageSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</Fragment>
	<section class="collection-gallery wall-gallery" aria-label="The Wall gallery">
		{processedEntries.map((entry, index) => (
			<div class="wall-thumb-wrapper">
				<div
					class="wall-thumb-link"
					role="button"
					tabindex="0"
					data-wall-index={index}
					data-wall-slug={entry.slug}
					data-wall-image={entry.lightboxSrc}
					data-wall-title={entry.data.title}
					data-wall-description={entry.data.description}
					data-wall-artist={entry.data.artist}
					data-wall-date={entry.data.dateOfCreation}
					data-wall-medium={entry.data.medium}
					data-wall-size={entry.data.size}
					aria-label={`${entry.data.title} by ${entry.data.artist}`}
				>
					{entry.original ? (
						<Image 
							src={entry.original} 
							alt={`${entry.data.title} by ${entry.data.artist}`}
							widths={[400, 800, 1200]} 
							sizes="(max-width: 768px) 100vw, 33vw" 
							format="webp" 
							loading="lazy" 
						/>
					) : (
						<img src={entry.data.image} alt={`${entry.data.title} by ${entry.data.artist}`} loading="lazy" />
					)}
				</div>
				<div class="sr-only">{entry.data.description}</div>
			</div>
		))}
	</section>

	<style is:global>
		.wall-thumb-wrapper {
			position: relative;
			overflow: hidden;
			aspect-ratio: 3 / 4;
		}

		.wall-thumb-link {
			display: block;
			width: 100%;
			height: 100%;
			overflow: hidden;
			cursor: pointer;
		}

		.wall-thumb-link img {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
			background: var(--color-neutral, #f2f2f2);
			transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
		}

		.wall-thumb-wrapper:hover .wall-thumb-link img {
			transform: scale(1.04);
		}


		.sr-only {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
			border: 0;
		}

		/* Lightbox overlay */
		.wall-lightbox {
			position: fixed;
			inset: 0;
			z-index: 9999;
			display: flex;
			align-items: center;
			justify-content: center;
			background: #ffffff;
			opacity: 0;
			pointer-events: none;
			transition: opacity 300ms ease;
			padding: 24px;
		}

		.wall-lightbox.is-open {
			opacity: 1;
			pointer-events: auto;
		}

		/* Close button — thin cross like PhotoSwipe */
		.wall-lightbox-close {
			position: absolute;
			top: 16px;
			right: 16px;
			z-index: 10;
			width: 44px;
			height: 44px;
			display: flex;
			align-items: center;
			justify-content: center;
			background: none;
			border: 0;
			cursor: pointer;
			color: rgba(26, 26, 26, 0.6);
			transition: color 180ms ease;
			padding: 0;
		}

		.wall-lightbox-close svg {
			fill: currentColor;
		}

		.wall-lightbox-close:hover {
			color: #1a1a1a;
		}

		.wall-lightbox-inner {
			display: flex;
			gap: 32px;
			max-width: 1100px;
			width: 100%;
			max-height: 90vh;
			align-items: center;
		}

		.wall-lightbox-image {
			flex: 1 1 60%;
			min-width: 0;
			max-height: 85vh;
			display: flex;
			align-items: center;
			justify-content: center;
			position: relative;
		}

		.wall-lightbox-image img {
			display: block;
			width: 100%;
			height: auto;
			max-height: 85vh;
			object-fit: contain;
			border-radius: 0;
			opacity: 0;
			transition: opacity 300ms ease;
		}

		.wall-lightbox-spinner {
			position: absolute;
			inset: 0;
			display: flex;
			align-items: center;
			justify-content: center;
			pointer-events: none;
			opacity: 0;
			transition: opacity 200ms ease;
		}

		.wall-lightbox-spinner.visible {
			opacity: 1;
		}

		.wall-lightbox-spinner::after {
			content: "";
			width: 28px;
			height: 28px;
			border: 2px solid rgba(26, 26, 26, 0.15);
			border-top-color: rgba(26, 26, 26, 0.6);
			border-radius: 50%;
			animation: wall-spin 600ms linear infinite;
		}

		@keyframes wall-spin {
			to { transform: rotate(360deg); }
		}

		.wall-lightbox-info {
			flex: 1 1 40%;
			min-width: 0;
			background: #ffffff;
			padding: 40px 32px;
			display: flex;
			flex-direction: column;
			gap: 16px;
			max-height: 85vh;
			overflow-y: auto;
		}

		.wall-lightbox-info .artwork-artist {
			font-size: 0.85rem;
			font-weight: 700;
			letter-spacing: 0.15em;
			text-transform: uppercase;
			color: #c8392b;
			margin: 0;
		}

		.wall-lightbox-info .artwork-title {
			font-size: 1.2rem;
			font-weight: 400;
			letter-spacing: 0.05em;
			line-height: 1.3;
			color: #1a1a1a;
			margin: 0;
		}

		.wall-lightbox-info .artwork-details {
			display: grid;
			gap: 6px;
			margin: 0;
			padding: 0;
		}

		.wall-lightbox-info .artwork-details dt {
			font-size: 0.65rem;
			font-weight: 700;
			letter-spacing: 0.2em;
			text-transform: uppercase;
			color: rgba(26, 26, 26, 0.5);
			margin-top: 10px;
		}

		.wall-lightbox-info .artwork-details dt:first-child {
			margin-top: 0;
		}

		.wall-lightbox-info .artwork-details dd {
			font-size: 0.85rem;
			font-weight: 400;
			line-height: 1.5;
			color: #1a1a1a;
			margin: 0;
		}

		.wall-lightbox-info .inquire-btn {
			display: inline-block;
			align-self: flex-start;
			padding: 10px 28px;
			background: #c8392b;
			color: #ffffff;
			font-family: "Century Gothic", "AppleGothic", sans-serif;
			font-size: 0.75rem;
			font-weight: 400;
			letter-spacing: 0.25em;
			text-transform: uppercase;
			text-decoration: none;
			border: 0;
			cursor: pointer;
			transition: background 180ms ease;
			margin-top: 4px;
		}

		.wall-lightbox-info .inquire-btn:hover {
			background: #a82f24;
		}

		/* Bottom nav in info panel */
		.wall-lightbox-info .nav-row {
			display: flex;
			gap: 12px;
			align-items: center;
			margin-top: auto;
			padding-top: 16px;
			border-top: 1px solid rgba(26, 26, 26, 0.1);
		}

		.wall-lightbox-info .nav-row button {
			padding: 6px 16px;
			background: transparent;
			border: 1px solid rgba(26, 26, 26, 0.18);
			cursor: pointer;
			font-family: "Century Gothic", "AppleGothic", sans-serif;
			font-size: 0.7rem;
			font-weight: 400;
			letter-spacing: 0.2em;
			text-transform: uppercase;
			color: #1a1a1a;
			transition: background 180ms ease;
		}

		.wall-lightbox-info .nav-row button:hover {
			background: #f2f2f2;
		}

		.wall-lightbox-info .nav-row button:disabled {
			opacity: 0.3;
			cursor: default;
			background: transparent;
		}

		.wall-lightbox-info .nav-row .counter {
			font-size: 0.75rem;
			color: rgba(26, 26, 26, 0.5);
			letter-spacing: 0.1em;
		}

		@media (max-width: 768px) {
			.wall-lightbox {
				padding: 64px 20px 32px 20px;
				align-items: flex-start;
				overflow-y: auto;
			}

			.wall-lightbox-close {
				position: fixed;
				top: 12px;
				right: 12px;
				background: #ffffff;
				border-radius: 50%;
			}

			.wall-lightbox-inner {
				flex-direction: column;
				gap: 20px;
				margin: 0 auto;
			}

			.wall-lightbox-image {
				flex: none;
				width: 100%;
				max-height: 55vh;
			}

			.wall-lightbox-image img {
				max-height: 55vh;
			}

			.wall-lightbox-info {
				flex: none;
				width: 100%;
				padding: 0 0 24px 0;
				max-height: none;
				overflow-y: visible;
			}
		}
	</style>

	<script>
		interface WallItem {
			image: string;
			title: string;
			description: string;
			artist: string;
			dateOfCreation: string;
			medium: string;
			size: string;
			slug: string;
		}

		interface LightboxState {
			overlay: HTMLDivElement | null;
			isOpen: boolean;
			items: WallItem[];
			currentIndex: number;
		}

		let state: LightboxState = {
			overlay: null,
			isOpen: false,
			items: [],
			currentIndex: 0,
		};

		/**
		 * Update the browser URL path to reflect the current artwork slug.
		 */
		const updatePath = () => {
			const item = state.items[state.currentIndex];
			if (!item) return;
			const slug = item.slug || `item-${state.currentIndex}`;
			history.replaceState({ wallIndex: state.currentIndex }, "", `/the-wall/${slug}`);
		};

		/**
		 * Restore the gallery path when closing the lightbox.
		 */
		const clearPath = () => {
			history.replaceState(null, "", "/the-wall");
		};

		/**
		 * Find the index of an item by its slug.
		 */
		const findIndexBySlug = (slug: string): number => {
			return state.items.findIndex((item) => item.slug === slug);
		};

		const createLightbox = (): HTMLDivElement => {
			const overlay = document.createElement("div");
			overlay.className = "wall-lightbox";
			overlay.setAttribute("role", "dialog");
			overlay.setAttribute("aria-modal", "true");
			overlay.setAttribute("aria-label", "Image lightbox");

		overlay.innerHTML = `
				<button class="wall-lightbox-close" type="button" aria-label="Close lightbox">
					<svg viewBox="0 0 200 200" width="24" height="24" xmlns="http://www.w3.org/2000/svg">
						<g>
							<path d="M166.333 38.892 160.442 33 99.667 93.775 38.892 33 33 38.892l60.775 60.775L33 160.442l5.892 5.891 60.775-60.775 60.775 60.775 5.891-5.891-60.775-60.775 60.775-60.775Z" fill-rule="evenodd"></path>
						</g>
					</svg>
				</button>
				<div class="wall-lightbox-inner">
					<div class="wall-lightbox-image">
						<img src="" alt="" />
						<div class="wall-lightbox-spinner"></div>
					</div>
					<div class="wall-lightbox-info">
						<p class="artwork-artist"></p>
						<h2 class="artwork-title"></h2>
						<dl class="artwork-details">
							<dt>Date of creation</dt>
							<dd class="detail-date"></dd>
							<dt>Medium</dt>
							<dd class="detail-medium"></dd>
							<dt>Size</dt>
							<dd class="detail-size"></dd>
						</dl>
						<a class="inquire-btn" href="mailto:art@tangorenholf.com">Inquire</a>
						<div class="nav-row">
							<button class="prev-btn" type="button">Prev</button>
							<span class="counter"></span>
							<button class="next-btn" type="button">Next</button>
						</div>
					</div>
				</div>
			`;

			document.body.appendChild(overlay);
			state.overlay = overlay;
			return overlay;
		};

		const getOrCreateOverlay = (): HTMLDivElement => {
			if (state.overlay && document.body.contains(state.overlay)) {
				return state.overlay;
			}
			return createLightbox();
		};

		const preloadAdjacent = () => {
			const prev = state.currentIndex - 1;
			const next = state.currentIndex + 1;
			if (prev >= 0) {
				const img = new Image();
				img.src = state.items[prev].image;
			}
			if (next < state.items.length) {
				const img = new Image();
				img.src = state.items[next].image;
			}
		};

		const updateLightboxContent = () => {
			const overlay = state.overlay;
			if (!overlay) return;

			const item = state.items[state.currentIndex];
			if (!item) return;

			const img = overlay.querySelector(".wall-lightbox-image img") as HTMLImageElement;
			const spinner = overlay.querySelector(".wall-lightbox-spinner") as HTMLDivElement;
			const artistEl = overlay.querySelector(".wall-lightbox-info .artwork-artist") as HTMLElement;
			const titleEl = overlay.querySelector(".wall-lightbox-info .artwork-title") as HTMLElement;
			const dateEl = overlay.querySelector(".wall-lightbox-info .detail-date") as HTMLElement;
			const mediumEl = overlay.querySelector(".wall-lightbox-info .detail-medium") as HTMLElement;
			const sizeEl = overlay.querySelector(".wall-lightbox-info .detail-size") as HTMLElement;
			const inquireBtn = overlay.querySelector(".wall-lightbox-info .inquire-btn") as HTMLAnchorElement;
			const counter = overlay.querySelector(".nav-row .counter") as HTMLElement;
			const prevBtn = overlay.querySelector(".nav-row .prev-btn") as HTMLButtonElement;
			const nextBtn = overlay.querySelector(".nav-row .next-btn") as HTMLButtonElement;

			// Reset state for animation and show spinner
			img.style.opacity = "0";
			spinner?.classList.add("visible");

			img.onload = () => {
				spinner?.classList.remove("visible");
				img.style.opacity = "1";
			};

			img.src = item.image;
			img.alt = item.title;
			artistEl.textContent = item.artist;
			titleEl.textContent = item.title;

			// Update inquire button with dynamic subject line
			const subject = `Inquiry: Artist: ${item.artist} Title: ${item.title}`;
			inquireBtn.href = `mailto:art@tangorenholf.com?subject=${encodeURIComponent(subject)}`;

			const hasDetails = item.dateOfCreation || item.medium || item.size;
			const detailsContainer = overlay.querySelector(".wall-lightbox-info .artwork-details") as HTMLElement;
			if (detailsContainer) {
				detailsContainer.style.display = hasDetails ? "grid" : "none";
			}

			dateEl.textContent = item.dateOfCreation || "—";
			mediumEl.textContent = item.medium || "—";
			sizeEl.textContent = item.size || "—";
			counter.textContent = `${state.currentIndex + 1} / ${state.items.length}`;

			const isFirst = state.currentIndex === 0;
			const isLast = state.currentIndex === state.items.length - 1;
			prevBtn.disabled = isFirst;
			nextBtn.disabled = isLast;

			preloadAdjacent();
			updatePath();
		};

		const getScrollbarWidth = (): number => {
			return window.innerWidth - document.documentElement.clientWidth;
		};

		const openLightbox = (index: number) => {
			if (state.items.length === 0) return;
			state.currentIndex = index;
			const overlay = getOrCreateOverlay();
			updateLightboxContent();

			// Compensate for scrollbar disappearance to prevent layout shift
			const scrollbarWidth = getScrollbarWidth();
			if (scrollbarWidth > 0) {
				document.body.style.paddingRight = `${scrollbarWidth}px`;
			}
			document.body.style.overflow = "hidden";

			// Trigger reflow for transition
			void overlay.offsetWidth;
			overlay.classList.add("is-open");
			state.isOpen = true;
		};

		const closeLightbox = () => {
			if (!state.overlay || !state.isOpen) return;
			state.overlay.classList.remove("is-open");
			state.isOpen = false;
			document.body.style.overflow = "";
			document.body.style.paddingRight = "";
			clearPath();

			// Clear content after fade-out transition completes
			state.overlay.addEventListener("transitionend", () => {
				if (!state.overlay?.classList.contains("is-open")) {
					const img = state.overlay.querySelector(".wall-lightbox-image img") as HTMLImageElement;
					if (img) {
						img.style.opacity = "0";
						img.src = "";
					}
					const artistEl = state.overlay.querySelector(".wall-lightbox-info .artwork-artist") as HTMLElement;
					const titleEl = state.overlay.querySelector(".wall-lightbox-info .artwork-title") as HTMLElement;
					if (artistEl) artistEl.textContent = "";
					if (titleEl) titleEl.textContent = "";
				}
			}, { once: true });
		};

		const goPrev = () => {
			if (state.currentIndex > 0) {
				state.currentIndex--;
				updateLightboxContent();
			}
		};

		const goNext = () => {
			if (state.currentIndex < state.items.length - 1) {
				state.currentIndex++;
				updateLightboxContent();
			}
		};

		const handleKeyDown = (e: KeyboardEvent) => {
			if (!state.isOpen) return;
			if (e.key === "Escape") {
				closeLightbox();
			} else if (e.key === "ArrowLeft") {
				goPrev();
			} else if (e.key === "ArrowRight") {
				goNext();
			}
		};

		/**
		 * Handle popstate (back/forward) — sync lightbox with the current path.
		 */
		const handlePopState = (e: PopStateEvent) => {
			const path = window.location.pathname;
			if (path.startsWith("/the-wall/") && path !== "/the-wall") {
				const slug = path.replace("/the-wall/", "");
				const index = findIndexBySlug(slug);
				if (index >= 0) {
					openLightbox(index);
				}
			} else {
				if (state.isOpen) {
					closeLightbox();
				}
			}
		};

		/**
		 * Check the URL hash on initial load — used when redirected from [slug].astro.
		 */
		const checkHashOnLoad = () => {
			const hash = window.location.hash.replace("#", "");
			if (!hash) return;
			const index = findIndexBySlug(hash);
			if (index >= 0) {
				openLightbox(index);
			}
		};

		const initWall = () => {
			// Collect all items from the DOM
			const triggers = document.querySelectorAll<HTMLElement>(".wall-thumb-link");
			state.items = [];
			triggers.forEach((btn) => {
				state.items.push({
					image: btn.dataset.wallImage || "",
					title: btn.dataset.wallTitle || "Untitled",
					description: btn.dataset.wallDescription || "",
					artist: btn.dataset.wallArtist || "",
					dateOfCreation: btn.dataset.wallDate || "",
					medium: btn.dataset.wallMedium || "",
					size: btn.dataset.wallSize || "",
					slug: btn.dataset.wallSlug || "",
				});
			});

			// Event delegation on the gallery section
			const gallery = document.querySelector(".wall-gallery");
			if (gallery && !gallery.dataset.wallReady) {
				gallery.dataset.wallReady = "true";
				gallery.addEventListener("click", (e) => {
					const link = (e.target as HTMLElement).closest<HTMLElement>(".wall-thumb-link");
					if (!link) return;
					const index = parseInt(link.dataset.wallIndex || "0", 10);
					openLightbox(index);
				});

				gallery.addEventListener("keydown", (e) => {
					if (e.key !== "Enter" && e.key !== " ") return;
					const link = (e.target as HTMLElement).closest<HTMLElement>(".wall-thumb-link");
					if (!link) return;
					e.preventDefault();
					const index = parseInt(link.dataset.wallIndex || "0", 10);
					openLightbox(index);
				});
			}

			// Lightbox internal event listeners (attached once)
			if (!document.body.dataset.wallListeners) {
				document.body.dataset.wallListeners = "true";

				document.addEventListener("keydown", handleKeyDown);

				document.addEventListener("click", (e) => {
					if (!state.isOpen || !state.overlay) return;

					const target = e.target as HTMLElement;

					// Close button
					if (target.closest(".wall-lightbox-close")) {
						closeLightbox();
						return;
					}

					// Backdrop click
					if (target === state.overlay) {
						closeLightbox();
						return;
					}

					// Prev/Next from nav-row
					if (target.closest(".nav-row .prev-btn")) {
						goPrev();
						return;
					}
					if (target.closest(".nav-row .next-btn")) {
						goNext();
						return;
					}
				});

				// Listen for hash changes
				window.addEventListener("popstate", handlePopState);
			}

			// Check if the initial path or hash points to a specific artwork
			handlePopState(new PopStateEvent("popstate"));
			checkHashOnLoad();
		};

		const cleanupWall = () => {
			if (state.overlay && document.body.contains(state.overlay)) {
				document.body.removeChild(state.overlay);
			}
			state.overlay = null;
			state.isOpen = false;
			state.items = [];
			state.currentIndex = 0;
			document.body.style.overflow = "";
			document.body.style.paddingRight = "";
		};

		document.addEventListener("astro:page-load", initWall);
		document.addEventListener("astro:before-preparation", cleanupWall);
	</script>
</BaseLayout>
