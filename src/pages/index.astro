---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Tangoren Holf | Art Consulting"
	description="Tangoren Holf is an art consulting firm for private, corporate, and hospitality collections."
	bodyClass="home-page"
>
	<section class="hero hero--home">
		<div class="hero-slideshow" aria-hidden="true">
			<div class="hero-slide hero-slide--one"></div>
			<div class="hero-slide hero-slide--two"></div>
			<div class="hero-slide hero-slide--three"></div>
		</div>
		<div class="hero__overlay"></div>
		<div class="hero__content hero__content--center">
			<a class="hero-logo" href="/" aria-label="Tangoren Holf home">
				<img src="/images/logo-th-main.png" alt="Tangoren Holf" />
			</a>
		</div>
	</section>
</BaseLayout>
