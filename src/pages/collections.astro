	<script>
		import PhotoSwipeLightbox from "photoswipe/lightbox";
		import PhotoSwipe from "photoswipe";
		import "photoswipe/style.css";

		let lightbox: InstanceType<typeof PhotoSwipeLightbox> | null = null;

		const initLightbox = () => {
			if (lightbox) {
				lightbox.destroy();
				lightbox = null;
			}

			if (!document.querySelector(".pswp-gallery")) return;

			lightbox = new PhotoSwipeLightbox({
				gallery: ".pswp-gallery",
				children: "a",
				pswpModule: PhotoSwipe,
			});

			lightbox.on("beforeOpen", () => {
				document.querySelectorAll(".pswp-gallery a").forEach((item) => {
					const img = item.querySelector("img");
					if (img && img.naturalWidth) {
						(item as HTMLElement).dataset.pswpWidth = String(img.naturalWidth);
						(item as HTMLElement).dataset.pswpHeight = String(img.naturalHeight);
					}
				});
			});

			lightbox.init();
		};

		document.addEventListener("astro:page-load", initLightbox);
		document.addEventListener("astro:before-preparation", () => {
			if (lightbox) {
				lightbox.destroy();
				lightbox = null;
			}
		});
	</script>
</BaseLayout>
