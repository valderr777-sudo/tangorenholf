---
import BaseLayout from "../layouts/BaseLayout.astro";

const services = [
	"Onsite Consultation and Assessments",
	"Collection Inventory Development",
	"Market Analysis",
	"Curatorial Work",
	"Art Research and Procurement",
	"Detailed Location Planning",
	"Discuss Budgetary Requirements",
	"Collaboration with Established and Emerging Artists",
	"Commissions",
	"Dealer Negotiation",
	"Auction Representation",
	"Liaison with Architects, Interior Designers and Art Handlers",
	"Conservation and Preservation of Art and Historic Works Advice",
	"Guidance with Custom Framing and Display",
	"Delivery and Installation",
	"Transportation Logistics",
	"Insurance",
	"Donation",
	"Complete Turnkey Services",
	"Lighting Systems to Illuminate and Display Artwork",
	"VIP Tours of Art Galleries and Artist Studios",
];
---

<BaseLayout title="Client Services | TANGOREN HOLF" description="Explore TANGOREN HOLF's full range of client services — from art consultation and curation to procurement, installation, and complete turnkey solutions for residential and commercial spaces.">
	<section class="page-section services-page">
		<div class="page-content">
			<h1 class="page-heading">CLIENT SERVICES</h1>
			<div class="page-body page-body--list">
				<ul class="services-list">
					{services.map((service) => <li class="services-list__item">{service}</li>)}
				</ul>
			</div>
		</div>
	</section>
</BaseLayout>