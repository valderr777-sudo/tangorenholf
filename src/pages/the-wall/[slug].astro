---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { Image, getImage } from "astro:assets";

export const prerender = true;

export async function getStaticPaths() {
	const entries = await getCollection("wall");
	// Deduplicate slugs: append entry id number for duplicate titles
	const seenSlugs = new Map<string, number>();
	return entries.map((entry) => {
		let slug = entry.data.title
			.toLowerCase()
			.replace(/[^a-z0-9]+/g, "-")
			.replace(/^-|-$/g, "");
		const count = seenSlugs.get(slug) || 0;
		seenSlugs.set(slug, count + 1);
		if (count > 0) {
			const num = entry.id.replace(/\.md$/, "");
			slug = `${slug}-${num}`;
		}
		return { params: { slug }, props: { entry } };
	});
}

const { entry } = Astro.props;

// Compute slug the same way as in getStaticPaths
const slug = entry.data.title
	.toLowerCase()
	.replace(/[^a-z0-9]+/g, "-")
	.replace(/^-|-$/g, "");

const rawImages = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/images/the-wall/*.{jpeg,jpg,png}",
	{ eager: true },
);

const assetPath = entry.data.image.replace("/images/", "/src/assets/images/");
const module = rawImages[assetPath];

let lightboxSrc = entry.data.image;
let original: ImageMetadata | null = null;

if (module) {
	original = module.default;
	const lightboxImage = await getImage({
		src: original,
		width: 1600,
		format: "webp",
	});
	lightboxSrc = lightboxImage.src;
}

const pageTitle = `${entry.data.title} by ${entry.data.artist} | The Wall | TANGOREN HOLF`;
const pageDescription = `${entry.data.title} by ${entry.data.artist}. ${entry.data.dateOfCreation}. ${entry.data.medium}. ${entry.data.size}. Available artwork from TANGOREN HOLF art consulting.`;

const visualArtworkSchema = {
	"@context": "https://schema.org",
	"@type": "VisualArtwork",
	"@id": Astro.url.href + "#artwork",
	"name": entry.data.title,
	"artform": entry.data.medium,
	"artist": {
		"@type": "Person",
		"name": entry.data.artist,
	},
	"dateCreated": entry.data.dateOfCreation,
	"artMedium": entry.data.medium,
	"image": new URL(lightboxSrc, Astro.url).href,
	"description": pageDescription,
	"size": entry.data.size,
	"provider": {
		"@type": "Organization",
		"name": "TANGOREN HOLF",
	},
};

const redirectUrl = `/the-wall#${slug}`;

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{
			"@type": "ListItem",
			"position": 1,
			"name": "Home",
			"item": "https://tangorenholf.com/",
		},
		{
			"@type": "ListItem",
			"position": 2,
			"name": "The Wall",
			"item": "https://tangorenholf.com/the-wall",
		},
		{
			"@type": "ListItem",
			"position": 3,
			"name": entry.data.title,
			"item": Astro.url.href,
		},
	],
};
---

<BaseLayout
	title={pageTitle}
	description={pageDescription}
	ogImage={lightboxSrc}
	ogImageAlt={entry.data.title}
	ogImageWidth={original?.width || 1200}
	ogImageHeight={original?.height || 630}
>
	<Fragment slot="head">
		<link rel="canonical" href={Astro.url.href} />
		<script type="application/ld+json" is:inline>
			{JSON.stringify(visualArtworkSchema)}
		</script>
		<script type="application/ld+json" is:inline>
			{JSON.stringify(breadcrumbSchema)}
		</script>
		<script define:vars={{ redirectUrl }}>
			// Redirect human users to the gallery page with the popup open.
			// Googlebot (which doesn't execute JS) will see the static content and index it.
			window.location.replace(redirectUrl);
		</script>
	</Fragment>

	<section class="artwork-detail">
		<div class="artwork-detail-inner">
			<div class="artwork-detail-image">
				{original ? (
					<Image
						src={original}
						alt={entry.data.title}
						widths={[400, 800, 1200]}
						sizes="(max-width: 768px) 100vw, 50vw"
						format="webp"
					/>
				) : (
					<img
						src={entry.data.image}
						alt={entry.data.title}
					/>
				)}
			</div>

			<div class="artwork-detail-info">
				<a class="artwork-detail-back" href="/the-wall">&larr; Back to The Wall</a>
				<p class="artwork-artist">{entry.data.artist}</p>
				<h1 class="artwork-title">{entry.data.title}</h1>
				<dl class="artwork-details">
					<dt>Date of creation</dt>
					<dd>{entry.data.dateOfCreation}</dd>
					<dt>Medium</dt>
					<dd>{entry.data.medium}</dd>
					<dt>Size</dt>
					<dd>{entry.data.size}</dd>
				</dl>
				<a class="inquire-btn" href="mailto:art@tangorenholf.com">Inquire</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.artwork-detail {
		padding: clamp(40px, 8vw, 80px) 24px;
		max-width: 1100px;
		margin: 0 auto;
	}

	.artwork-detail-inner {
		display: flex;
		gap: 48px;
		align-items: flex-start;
	}

	.artwork-detail-image {
		flex: 1 1 55%;
		min-width: 0;
	}

	.artwork-detail-image img {
		display: block;
		width: 100%;
		height: auto;
		object-fit: contain;
		background: #f2f2f2;
	}

	.artwork-detail-info {
		flex: 1 1 45%;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding-top: 0;
	}

	.artwork-detail-back {
		font-family: "Century Gothic", "AppleGothic", sans-serif;
		font-size: 0.75rem;
		font-weight: 400;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: rgba(26, 26, 26, 0.5);
		text-decoration: none;
		transition: color 180ms ease;
	}

	.artwork-detail-back:hover {
		color: #c8392b;
	}

	.artwork-artist {
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: #c8392b;
		margin: 0;
	}

	.artwork-title {
		font-size: 1.5rem;
		font-weight: 400;
		letter-spacing: 0.05em;
		line-height: 1.3;
		color: #1a1a1a;
		margin: 0;
	}

	.artwork-details {
		display: grid;
		gap: 6px;
		margin: 0;
		padding: 0;
	}

	.artwork-details dt {
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: rgba(26, 26, 26, 0.5);
		margin-top: 10px;
	}

	.artwork-details dt:first-child {
		margin-top: 0;
	}

	.artwork-details dd {
		font-size: 0.85rem;
		font-weight: 400;
		line-height: 1.5;
		color: #1a1a1a;
		margin: 0;
	}

	.inquire-btn {
		display: inline-block;
		align-self: flex-start;
		padding: 10px 28px;
		background: #c8392b;
		color: #ffffff;
		font-family: "Century Gothic", "AppleGothic", sans-serif;
		font-size: 0.75rem;
		font-weight: 400;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		text-decoration: none;
		border: 0;
		cursor: pointer;
		transition: background 180ms ease;
		margin-top: 4px;
	}

	.inquire-btn:hover {
		background: #a82f24;
	}

	@media (max-width: 768px) {
		.artwork-detail-inner {
			flex-direction: column;
			gap: 24px;
		}

		.artwork-detail-info {
			padding-top: 0;
		}
	}
</style>
