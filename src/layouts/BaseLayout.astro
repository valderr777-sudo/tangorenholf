---
import "../styles/global.css";
import { ClientRouter, fade } from "astro:transitions";

interface Props {
	title?: string;
	description?: string;
	bodyClass?: string;
	canonical?: string;
	ogImage?: string;
	ogImageAlt?: string;
	ogImageWidth?: number;
	ogImageHeight?: number;
	hideHeaderFooter?: boolean;
}

const {
	title = "TANGOREN HOLF",
	description = "An award-winning residential design studio known for full-service interior design, with a portfolio spanning national and international projects.",
	bodyClass = "",
	canonical,
	ogImage = "/images/social-share.jpg",
	ogImageAlt = "TANGOREN HOLF Art Consulting",
	ogImageWidth = 1200,
	ogImageHeight = 630,
	hideHeaderFooter = false,
} = Astro.props;

const htmlClass = bodyClass.split(" ").includes("home-page") ? "home-document" : "";
const canonicalUrl = canonical || Astro.url.href;

const isHomePage = bodyClass.split(" ").includes("home-page");
const headerLogoSrc = isHomePage ? "/images/tangoren logo white.svg" : "/images/TH-LOGO.svg";

const navItems = [
	{ href: "/about", label: "ABOUT" },
	{ href: "/client-services", label: "CLIENT SERVICES" },
	{ href: "/collections", label: "COLLECTIONS" },
	{ href: "/the-wall", label: "THE WALL" },
	{ href: "/contact", label: "CONTACT" },
];

const mobileNavItems = [
	{ href: "/", label: "HOME" },
	...navItems,
];

const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	"@id": "https://tangorenholf.com/#organization",
	"name": "TANGOREN HOLF",
	"url": "https://tangorenholf.com",
	"logo": "https://tangorenholf.com/images/TH-LOGO.svg",
	"description": description,
	"email": "art@tangorenholf.com",
	"sameAs": [
		"https://www.facebook.com/tangorenholf"
	]
};

const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"@id": "https://tangorenholf.com/#website",
	"url": "https://tangorenholf.com",
	"name": "TANGOREN HOLF",
	"inLanguage": "en",
	"potentialAction": {
		"@type": "SearchAction",
		"target": {
			"@type": "EntryPoint",
			"urlTemplate": "https://tangorenholf.com/search?q={search_term_string}"
		},
		"query-input": "required name=search_term_string"
	}
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{
			"@type": "ListItem",
			"position": 1,
			"name": "Home",
			"item": "https://tangorenholf.com/"
		}
	]
};
---

<!doctype html>
<html lang="en" class={htmlClass}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="index, follow" />
		<meta name="author" content="TANGOREN HOLF" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalUrl} />

		<!-- Open Graph / Social Share -->
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:site_name" content="TANGOREN HOLF" />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content={ogImageWidth} />
		<meta property="og:image:height" content={ogImageHeight} />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		<!-- Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

		<title transition:animate="none">{title}</title>
		<slot name="head" />
		<ClientRouter />
		<style is:inline>
			@font-face {
				font-family: 'Century Gothic';
				font-display: block;
			}

			html {
				scrollbar-color: #C8392B rgba(26, 26, 26, 0.08);
				scrollbar-width: thin;
			}

			::-webkit-scrollbar {
				width: 8px;
				height: 8px;
			}

			::-webkit-scrollbar-track {
				background: rgba(26, 26, 26, 0.08);
			}

			::-webkit-scrollbar-thumb {
				background: #C8392B;
				border: 2px solid rgba(255, 255, 255, 0.9);
			}

			.site-header {
				view-transition-name: site-header;
			}
			.site-header.is-scrolled,
			body.menu-open .site-header {
				background: rgba(255, 255, 255, 0.6);
				backdrop-filter: blur(6px);
				-webkit-backdrop-filter: blur(6px);
			}
		</style>
	</head>

	<body class={bodyClass}>
		<slot name="preloader" />

		{!hideHeaderFooter && (
			<>
				<header class="site-header site-header--topbar" data-site-header>
					<a class="site-logo" href="/" aria-label="TANGOREN HOLF home">
						<img src={headerLogoSrc} alt="TANGOREN HOLF" />
					</a>

					<nav class="desktop-nav" aria-label="Primary navigation">
						{navItems.map((item) => <a href={item.href}>{item.label}</a>)}
					</nav>

					<button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" data-menu-toggle>
						<svg preserveAspectRatio="xMidYMid meet" viewBox="20 49 160 102" xmlns="http://www.w3.org/2000/svg" fill="currentColor">
							<g>
								<path d="M180 138.25V151H20v-12.75h160z"></path>
								<path d="M180 49v12.75H20V49h160z"></path>
								<path d="M180 93.625v12.75H20v-12.75h160z"></path>
							</g>
						</svg>
					</button>
				</header>

				<div class="mobile-menu" data-mobile-menu>
					<nav aria-label="Mobile navigation">
						{mobileNavItems.map((item) => <a href={item.href}>{item.label}</a>)}
					</nav>
				</div>
			</>
		)}

		<div transition:animate={fade({ duration: 400 })}>
			<main>
				<slot />
			</main>

			{!hideHeaderFooter && (
				<footer class="site-footer">
					<p>&copy;2026 TANGOREN HOLF. All rights reserved.</p>
				</footer>
			)}
		</div>

		<script>
			import Lenis from "lenis";

			let lenis = null;
			let lenisFrame = null;

			const initLenis = () => {
				if (document.body.classList.contains("home-page")) return;
				if (lenis) {
					lenis.destroy();
					lenis = null;
				}

				lenis = new Lenis({
					duration: 1.2,
					easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
					orientation: "vertical",
					smoothWheel: true,
				});

				const raf = (time) => {
					if (!lenis) return;
					lenis.raf(time);
					lenisFrame = requestAnimationFrame(raf);
				};
				lenisFrame = requestAnimationFrame(raf);
			};

			const destroyLenis = () => {
				if (lenisFrame) {
					cancelAnimationFrame(lenisFrame);
					lenisFrame = null;
				}
				if (lenis) {
					lenis.destroy();
					lenis = null;
				}
			};

			const syncHeader = () => {
				const header = document.querySelector("[data-site-header]");
				header?.classList.toggle("is-scrolled", window.scrollY > 7.1);
			};

			const updateLogo = () => {
				const logoImg = document.querySelector(".site-logo img");
				if (!logoImg) return;
				const isHome = document.body.classList.contains("home-page");
				logoImg.src = isHome ? "/images/tangoren logo white.svg" : "/images/TH-LOGO.svg";
			};

			const closeMenu = () => {
				const toggle = document.querySelector("[data-menu-toggle]");
				document.body.classList.remove("menu-open");
				toggle?.setAttribute("aria-expanded", "false");
				toggle?.setAttribute("aria-label", "Open menu");
			};

			const initMenu = () => {
				const toggle = document.querySelector("[data-menu-toggle]");
				const mobileMenu = document.querySelector("[data-mobile-menu]");

				if (toggle instanceof HTMLElement && !toggle.dataset.menuReady) {
					toggle.dataset.menuReady = "true";
					toggle.addEventListener("click", () => {
						const isOpen = document.body.classList.toggle("menu-open");
						toggle.setAttribute("aria-expanded", String(isOpen));
						toggle.setAttribute("aria-label", isOpen ? "Close menu" : "Open menu");

						const logoImg = document.querySelector(".site-logo img");
						if (logoImg && document.body.classList.contains("home-page")) {
							logoImg.src = isOpen ? "/images/TH-LOGO.svg" : "/images/tangoren logo white.svg";
						}
					});
				}

				mobileMenu?.querySelectorAll("a").forEach((link) => {
					if (link instanceof HTMLElement && !link.dataset.menuReady) {
						link.dataset.menuReady = "true";
						link.addEventListener("click", closeMenu);
					}
				});
			};

			const initPage = () => {
				closeMenu();
				syncHeader();
				updateLogo();
				initMenu();
				initLenis();
			};

			window.addEventListener("scroll", syncHeader, { passive: true });
			document.addEventListener("astro:page-load", initPage);
			initPage();

			document.addEventListener("astro:before-preparation", destroyLenis);
		</script>
	</body>
</html>
